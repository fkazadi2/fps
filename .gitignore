# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# copies du build (.next.bak, .next-old...) : Tailwind analyse tout dossier non ignoré
/.next*/

# production
/build

# misc
.DS_Store
*.pem

# identifiants et rapports locaux (jamais dans le dépôt public)
user-*.txt
*recovery-codes*.txt
goaccess-*.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
